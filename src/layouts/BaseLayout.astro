---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = '记录真实实验，分享长期积累。关注软件开发、微信生态、金融研究与自动化工具。' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const path = Astro.url.pathname.replace(base, '/');
const nav = [['/', '首页'], ['/labs/', '实验室'], ['/tools/', '工具'], ['/updates/', '最新动态'], ['/about/', '关于'], ['/contact/', '联系']];
const url = (p: string) => `${base}${p.replace(/^\//, '')}`;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="generator" content={Astro.generator} /><meta name="description" content={description} /><meta name="theme-color" content="#f8f7f4" /><link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} /><link rel="canonical" href={Astro.url} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><title>{title}</title><script defer src="https://myanalytics.pages.dev/tracker.min.js" data-website-id="a-web-xiaoliulab-site"></script></head><body>
<header class="site-header"><div class="container nav-wrap"><a class="brand" href={url('/')} aria-label="小刘实验室首页"><span class="brand-mark">L</span><span>小刘实验室<small>XIAOLIU LAB</small></span></a><nav aria-label="主导航">{nav.map(([href,label]) => <a class:list={{active:href==='/'?path==='/':path.startsWith(href)}} href={url(href)}>{label}</a>)}<a class="docs-link" href="https://docs.xiaoliulab.com">文档 ↗</a></nav><button class="menu" aria-label="打开导航" aria-expanded="false"><span></span><span></span><span></span></button></div></header>
<main><slot /></main>
<footer><div class="container footer-grid"><div><a class="brand footer-brand" href={url('/')}><span class="brand-mark">L</span><span>小刘实验室<small>XIAOLIU LAB</small></span></a><p>记录真实实验，分享长期积累。</p></div><div><h3>探索</h3><a href={url('/labs/')}>实验室</a><a href={url('/updates/')}>最新动态</a><a href="https://docs.xiaoliulab.com">文档中心 ↗</a></div><div><h3>关于</h3><a href={url('/about/')}>关于实验室</a><a href={url('/contact/')}>联系我们</a><a href="https://github.com/valuetodays">GitHub ↗</a></div></div><div class="container copyright"><span>© {new Date().getFullYear()} 小刘实验室</span><span>真实实验 · 长期积累 · 开放分享</span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">京ICP备17040585号-6</a></div></footer>
<script>const button=document.querySelector('.menu');const nav=document.querySelector('nav');button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open)});</script></body></html>
