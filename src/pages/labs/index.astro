---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import { labs, experiments } from '../../data/site';
---
<BaseLayout title="实验室｜小刘实验室"><PageHero eyebrow="LABORATORIES" title="实验室" description="围绕真实问题建立长期实验，用数据验证想法，用记录沉淀经验。" /><section class="section"><div class="container"><div class="lab-grid">{labs.map(lab=><article class={`lab-card ${lab.tone}`}><div class="lab-icon">{lab.icon}</div><h2>{lab.title}</h2><p>{lab.description}</p><div class="tags">{lab.tags.map(t=><span>{t}</span>)}</div>{lab.href && <a href={lab.href}>查看专题 <span>↗</span></a>}</article>)}</div></div></section><section class="section experiments-section"><div class="container"><div class="section-head"><div><span class="eyebrow">全部实验</span><h2>持续进行中的研究</h2></div></div><div class="experiment-grid">{experiments.map(item=><article class="experiment-card"><div class="experiment-top"><span class="exp-icon">{item.icon}</span><span class:list={['status',{verified:item.status==='已验证' || item.status==='专题已发布'}]}>{item.status}</span></div><small>{item.category}</small><h3>{item.title}</h3><p>{item.description}</p><div class="card-foot"><span>更新于 {item.updated}</span><a href={item.href ?? 'https://docs.xiaoliulab.com'}>查看文档 ↗</a></div></article>)}</div></div></section></BaseLayout>
