---
import BaseLayout from '../layouts/BaseLayout.astro'; import { labs, experiments, updates } from '../data/site'; const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:`${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="小刘实验室｜记录真实实验，分享长期积累">
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow"><i></i> 欢迎来到小刘实验室</span><h1>让每一次探索，<br /><em>都有数据可循。</em></h1><p>这里记录软件开发、微信生态与金融研究中的真实实验。我们验证想法、公开过程，也诚实记录失败。</p><div class="actions"><a class="button primary" href={`${base}labs/`}>探索实验 <span>→</span></a><a class="button secondary" href="https://docs.xiaoliulab.com">阅读文档 ↗</a></div><div class="hero-note"><span>●</span> 所有内容均来自真实项目与持续验证</div></div><div class="lab-visual"><div class="visual-top"><span><i></i><i></i><i></i></span><b>LAB / LIVE DATA</b></div><div class="metric"><span>本周实验记录</span><strong>27</strong><small>+ 12.5%</small></div><div class="chart">{[34,48,39,66,58,82,72,91].map(h=><span style={`height:${h}%`}></span>)}</div><div class="visual-stats"><span><i class="dot blue"></i>进行中 <b>08</b></span><span><i class="dot orange"></i>已验证 <b>19</b></span></div><div class="float-card"><span>实验原则</span><b>真实验证</b><small>DATA, NOT HYPE</small></div></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">探索方向</span><h2>从真实问题出发</h2></div><p>每个实验室都围绕一个长期方向，持续验证、记录与迭代。</p></div><div class="lab-grid">{labs.map(lab=><article class={`lab-card ${lab.tone}`}><div class="lab-icon">{lab.icon}</div><h3>{lab.title}</h3><p>{lab.description}</p><div class="tags">{lab.tags.map(t=><span>{t}</span>)}</div><a href={`${base}labs/`}>进入实验室 <span>→</span></a></article>)}</div></div></section>
<section class="section experiments-section"><div class="container"><div class="section-head"><div><span class="eyebrow">精选实验</span><h2>最近，我们在做这些</h2></div><a class="text-link" href={`${base}labs/`}>查看全部实验 →</a></div><div class="experiment-grid">{experiments.map(item=><article class="experiment-card"><div class="experiment-top"><span class="exp-icon">{item.icon}</span><span class:list={['status',{verified:item.status==='已验证'}]}>{item.status}</span></div><small>{item.category}</small><h3>{item.title}</h3><p>{item.description}</p><div class="card-foot"><span>更新于 {item.updated}</span><a href="https://docs.xiaoliulab.com">↗</a></div></article>)}</div></div></section>
<section class="section"><div class="container two-col"><div><span class="eyebrow">最新动态</span><h2>实验仍在继续</h2><p class="lead">每一次更新，都是长期积累的一小步。</p><a class="button secondary" href={`${base}updates/`}>查看全部动态 →</a></div><div class="updates-list">{updates.slice(0,4).map(item=><a href={`${base}updates/`}><time><b>{item.date}</b><small>{item.year}</small></time><div><span>{item.type}</span><h3>{item.title}</h3></div><i>→</i></a>)}</div></div></section>
<section class="principles"><div class="container"><div class="center-head"><span class="eyebrow">我们的原则</span><h2>认真做实验，诚实写结果</h2></div><div class="principle-grid"><article><b>01</b><h3>真实验证</h3><p>所有实验来自真实项目与真实数据，不用想象代替结果。</p></article><article><b>02</b><h3>记录过程</h3><p>记录成功，也记录失败。过程往往比结论更值得参考。</p></article><article><b>03</b><h3>长期维护</h3><p>实验不是一次性文章，而是一份随着实践持续更新的记录。</p></article></div></div></section>
<section class="cta"><div class="container"><div><span class="eyebrow light">下一站</span><h2>选择一个感兴趣的实验，<br />开始探索。</h2></div><div class="actions"><a class="button white" href={`${base}labs/`}>浏览所有实验 →</a><a class="button ghost" href="https://docs.xiaoliulab.com">查看文档 ↗</a></div></div></section></BaseLayout>
